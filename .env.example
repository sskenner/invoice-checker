# Set these as environment variables in your shell. Never commit real values.

# Required for extract.py (Claude reads the invoice PDFs)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional: file held invoices as Jira tickets (jira_sync.py)
JIRA_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=KAN

# Optional: read purchase orders from a Procore sandbox (check.py --source procore)
PROCORE_CLIENT_ID=your_procore_client_id
PROCORE_CLIENT_SECRET=your_procore_client_secret
PROCORE_COMPANY_ID=your_sandbox_company_id
PROCORE_PROJECT_ID=your_sandbox_project_id
